        childSphere(0.45f,0.78f,1.38f,0.20f,0.25f,0.12f,14,0.38f,0.20f,0.12f);
        // eyes, nose, teeth
        childSphere(-0.31f,0.45f,1.90f,0.085f,0.10f,0.07f,0,0.03f,0.025f,0.02f);
        childSphere(0.31f,0.45f,1.90f,0.085f,0.10f,0.07f,0,0.03f,0.025f,0.02f);
        childSphere(0,0.10f,2.34f,0.18f,0.12f,0.08f,0,0.16f,0.08f,0.05f);
        childCube(-0.11f,-0.15f,2.29f,0.08f,0.13f,0.035f,0,0.92f,0.87f,0.70f);
        childCube(0.11f,-0.15f,2.29f,0.08f,0.13f,0.035f,0,0.92f,0.87f,0.70f);
        // legs
        childCube(-0.76f,-0.62f,0.75f,0.28f,0.55f,0.25f,legSwing*20f,0.38f,0.22f,0.12f);
        childCube(0.76f,-0.62f,0.75f,0.28f,0.55f,0.25f,-legSwing*20f,0.38f,0.22f,0.12f);
        childCube(-0.76f,-0.62f,-0.73f,0.29f,0.55f,0.26f,-legSwing*20f,0.38f,0.22f,0.12f);
        childCube(0.76f,-0.62f,-0.73f,0.29f,0.55f,0.26f,legSwing*20f,0.38f,0.22f,0.12f);
        popModel();
    }

    private final float[] parentModel=new float[16];
    private boolean usingParent=false;
    private void pushModel(float x,float y,float z,float rot,float sx,float sy,float sz){
        Matrix.setIdentityM(parentModel,0);
        Matrix.translateM(parentModel,0,x,y,z);
        Matrix.rotateM(parentModel,0,rot,0,1,0);
        Matrix.scaleM(parentModel,0,sx,sy,sz);
        usingParent=true;
    }
    private void popModel(){usingParent=false;}
    private void childSphere(float x,float y,float z,float sx,float sy,float sz,float rot,float r,float g,float b){
        drawWithParent(sphere,x,y,z,sx,sy,sz,rot,r,g,b);
    }
    private void childCube(float x,float y,float z,float sx,float sy,float sz,float rot,float r,float g,float b){
        drawWithParent(cube,x,y,z,sx,sy,sz,rot,r,g,b);
    }
    private void drawWithParent(Mesh mesh,float x,float y,float z,float sx,float sy,float sz,float rot,float r,float g,float b){
        float[] local=new float[16];
        Matrix.setIdentityM(local,0);
        Matrix.translateM(local,0,x,y,z);
        Matrix.rotateM(local,0,rot,1,0,0);
        Matrix.scaleM(local,0,sx,sy,sz);
        Matrix.multiplyMM(model,0,parentModel,0,local,0);
        render(mesh,r,g,b);
    }

    private void drawCube(float x,float y,float z,float sx,float sy,float sz,float rot,float r,float g,float b){
        compose(x,y,z,sx,sy,sz,rot); render(cube,r,g,b);
    }
    private void drawSphere(float x,float y,float z,float sx,float sy,float sz,float rot,float r,float g,float b){
        compose(x,y,z,sx,sy,sz,rot); render(sphere,r,g,b);
    }
    private void compose(float x,float y,float z,float sx,float sy,float sz,float rot){
        Matrix.setIdentityM(model,0);
        Matrix.translateM(model,0,x,y,z);
        Matrix.rotateM(model,0,rot,0,1,0);
        Matrix.scaleM(model,0,sx,sy,sz);
    }
    private void render(Mesh mesh,float r,float g,float b){
        Matrix.multiplyMM(mv,0,view,0,model,0);
        Matrix.multiplyMM(mvp,0,projection,0,mv,0);
        GLES20.glUniformMatrix4fv(uMvp,1,false,mvp,0);
        GLES20.glUniformMatrix4fv(uModel,1,false,model,0);
        GLES20.glUniform4f(uColor,r,g,b,1f);
        mesh.draw(aPosition,aNormal);
    }

    private int buildProgram(String vs,String fs){
        int vertex=compile(GLES20.GL_VERTEX_SHADER,vs);
        int fragment=compile(GLES20.GL_FRAGMENT_SHADER,fs);
        int p=GLES20.glCreateProgram();
        GLES20.glAttachShader(p,vertex); GLES20.glAttachShader(p,fragment); GLES20.glLinkProgram(p);
        int[] ok=new int[1]; GLES20.glGetProgramiv(p,GLES20.GL_LINK_STATUS,ok,0);
        if(ok[0]==0) throw new RuntimeException("Shader link: "+GLES20.glGetProgramInfoLog(p));
        GLES20.glDeleteShader(vertex); GLES20.glDeleteShader(fragment); return p;
    }
    private int compile(int type,String src){
        int s=GLES20.glCreateShader(type); GLES20.glShaderSource(s,src); GLES20.glCompileShader(s);
        int[] ok=new int[1]; GLES20.glGetShaderiv(s,GLES20.GL_COMPILE_STATUS,ok,0);
        if(ok[0]==0) throw new RuntimeException("Shader: "+GLES20.glGetShaderInfoLog(s));
        return s;
    }

    private static final String VERTEX =
            "uniform mat4 uMVP;\n"+
            "uniform mat4 uModel;\n"+
            "attribute vec3 aPosition;\n"+
            "attribute vec3 aNormal;\n"+
            "varying vec3 vNormal;\n"+
            "varying float vHeight;\n"+
            "void main(){\n"+
            " vec4 world=uModel*vec4(aPosition,1.0);\n"+
            " vNormal=normalize(mat3(uModel)*aNormal);\n"+
            " vHeight=world.y;\n"+
            " gl_Position=uMVP*vec4(aPosition,1.0);\n"+
            "}";
    private static final String FRAGMENT =
            "precision mediump float;\n"+
            "uniform vec4 uColor;\n"+
            "uniform vec3 uLightDir;\n"+
            "varying vec3 vNormal;\n"+
            "varying float vHeight;\n"+
            "void main(){\n"+
            " float d=max(dot(normalize(vNormal),normalize(uLightDir)),0.0);\n"+
            " float light=0.44+0.56*d;\n"+
            " float warm=clamp(vHeight/18.0,0.0,0.10);\n"+
            " gl_FragColor=vec4(uColor.rgb*light+vec3(warm),uColor.a);\n"+
            "}";
}
