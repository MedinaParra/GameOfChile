public final class MainActivity extends Activity {
    private GameView gameView;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        requestWindowFeature(Window.FEATURE_NO_TITLE);
        getWindow().setFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN,
                WindowManager.LayoutParams.FLAG_FULLSCREEN);
        hideSystemUi();

        FrameLayout root = new FrameLayout(this);
        gameView = new GameView(this);
        HudView hudView = new HudView(this, gameView.getRenderer());
        gameView.setHudView(hudView);
        root.addView(gameView, new FrameLayout.LayoutParams(
                FrameLayout.LayoutParams.MATCH_PARENT,
                FrameLayout.LayoutParams.MATCH_PARENT));
        root.addView(hudView, new FrameLayout.LayoutParams(
                FrameLayout.LayoutParams.MATCH_PARENT,
                FrameLayout.LayoutParams.MATCH_PARENT));
        setContentView(root);
    }

    private void hideSystemUi() {
        getWindow().getDecorView().setSystemUiVisibility(
                View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY
                        | View.SYSTEM_UI_FLAG_FULLSCREEN
                        | View.SYSTEM_UI_FLAG_HIDE_NAVIGATION
                        | View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN
                        | View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION
                        | View.SYSTEM_UI_FLAG_LAYOUT_STABLE);
    }

    @Override
    protected void onResume() {
        super.onResume();
        hideSystemUi();
        if (gameView != null) gameView.onResume();
    }

    @Override
    protected void onPause() {
        if (gameView != null) gameView.onPause();
        super.onPause();
    }
}

final class HudView extends View {
    private final GameRenderer renderer;
    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
    private final Paint text = new Paint(Paint.ANTI_ALIAS_FLAG);

    public HudView(Context context, GameRenderer renderer) {
        super(context);
        this.renderer = renderer;
        setClickable(false);
        setFocusable(false);
        text.setTypeface(android.graphics.Typeface.create("sans", android.graphics.Typeface.BOLD));
    }

    @Override
    protected void onDraw(Canvas canvas) {
        super.onDraw(canvas);
        float density = getResources().getDisplayMetrics().density;
        float w = getWidth();
        float h = getHeight();

        paint.setColor(Color.argb(120, 15, 35, 18));
        canvas.drawRoundRect(new RectF(18*density, 16*density, 270*density, 82*density),
                18*density, 18*density, paint);
        text.setTextSize(25*density);
        text.setColor(Color.WHITE);
        canvas.drawText("A-tatis", 34*density, 46*density, text);
        text.setTextSize(16*density);
        text.setColor(Color.rgb(255, 226, 110));
        canvas.drawText("🍎 " + renderer.getScore() + " / " + renderer.getGoal(),
                35*density, 70*density, text);

        float cx = renderer.getJoystickCenterX();
        float cy = renderer.getJoystickCenterY();
        float base = 74*density;
        if (cx <= 0) { cx = 100*density; cy = h - 100*density; }
        paint.setStyle(Paint.Style.FILL);
        paint.setColor(Color.argb(65, 255, 255, 255));
        canvas.drawCircle(cx, cy, base, paint);
        paint.setStyle(Paint.Style.STROKE);
        paint.setStrokeWidth(3*density);
        paint.setColor(Color.argb(160, 255, 255, 255));
        canvas.drawCircle(cx, cy, base, paint);
        paint.setStyle(Paint.Style.FILL);
        paint.setColor(Color.argb(175, 255, 255, 255));
        canvas.drawCircle(cx + renderer.getJoystickX()*base,
                cy + renderer.getJoystickY()*base, 30*density, paint);

        paint.setColor(Color.argb(80, 15, 35, 18));
        canvas.drawRoundRect(new RectF(w - 245*density, h - 58*density,
                w - 18*density, h - 18*density), 15*density, 15*density, paint);
        text.setTextSize(13*density);
        text.setColor(Color.WHITE);
        canvas.drawText("Arrastra aquí para mirar", w - 226*density, h - 33*density, text);

        if (renderer.isVictory()) {
            paint.setColor(Color.argb(205, 13, 39, 18));
            canvas.drawRoundRect(new RectF(w*0.24f, h*0.29f, w*0.76f, h*0.70f),
                    28*density, 28*density, paint);
            text.setTextAlign(Paint.Align.CENTER);
            text.setTextSize(42*density);
            text.setColor(Color.rgb(255, 225, 90));
            canvas.drawText("¡Bosque completado!", w/2f, h*0.44f, text);
            text.setTextSize(21*density);
            text.setColor(Color.WHITE);
            canvas.drawText("A-tatis encontró todas las manzanas", w/2f, h*0.53f, text);
            text.setTextSize(16*density);
            canvas.drawText("Sigue explorando: las manzanas continúan apareciendo", w/2f, h*0.61f, text);
            text.setTextAlign(Paint.Align.LEFT);
        }

        postInvalidateDelayed(33);
    }
}

