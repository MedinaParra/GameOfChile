 false\\n    collected_ids.append(id); count_changed.emit(collected_ids.size())\\n    if collected_ids.size()==50: all_collected.emit()\\n    return true\\nfunc count() -> int:return collected_ids.size()\\n", "scripts/CrowEnemy.gd": "extends Node3D\\nclass_name CrowEnemy\\nvar player: PlayerController\\nvar center:=Vector3.ZERO\\nvar phase:=0.0\\nvar cooldown:=0.0\\nfunc build() -> void:\\n    var mat:=StandardMaterial3D.new(); mat.albedo_color=Color(\\"202433\\")\\n    for side in [-1,1]:\\n        var wing:=MeshInstance3D.new(); var box:=BoxMesh.new(); box.size=Vector3(1.1,.08,.45); box.material=mat; wing.mesh=box; wing.position.x=side*.55; wing.name=\\"Wing\\"; add_child(wing)\\n    var b:=MeshInstance3D.new(); var sm:=SphereMesh.new(); sm.material=mat; b.mesh=sm; b.scale=Vector3(.45,.32,.6); add_child(b)\\nfunc _process(delta: float) -> void:\\n    if not is_instance_valid(player):return\\n    phase+=delta; cooldown=max(0.0,cooldown-delta)\\n    var orbit:=center+Vector3(cos(phase)*5.0,4.5+sin(phase*2)*.5,sin(phase)*5.0)\\n    if global_position.distance_to(player.global_position)<8.0 and cooldown<=0: orbit=player.global_position+Vector3.UP*.8\\n    global_position=global_position.lerp(orbit,delta*1.8)\\n    for c in get_children(): if c.name==\\"Wing\\": c.rotation.z=sin(phase*8.0)*.55\\n    if global_position.distance_to(player.global_position)<1.0 and cooldown<=0: player.take_damage(1,Vector3(0,2,3)); cooldown=3.0\\n", "scripts/DoorController.gd": "extends StaticBody3D\\nclass_name DoorController\\nvar opened:=false\\nvar mesh_node: MeshInstance3D\\nvar collision: CollisionShape3D\\nfunc build() -> void:\\n    collision_layer=1; collision_mask=0\\n    mesh_node=MeshInstance3D.new(); var mesh:=BoxMesh.new(); mesh.size=Vector3(.7,4.5,5.5); var mat:=StandardMaterial3D.new(); mat.albedo_color=Color(\\"3d6145\\"); mat.emission_enabled=true; mat.emission=Color(\\"17402b\\"); mesh.material=mat; mesh_node.mesh=mesh; mesh_node.position.y=2.25; add_child(mesh_node)\\n 