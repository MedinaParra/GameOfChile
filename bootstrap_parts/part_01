]\\nsize/viewport_width=1280\\nsize/viewport_height=720\\nsize/window_width_override=1280\\nsize/window_height_override=720\\nstretch/mode=\\"canvas_items\\"\\nhandheld/orientation=1\\nenergy_saving/keep_screen_on=true\\n\\n[rendering]\\nrenderer/rendering_method=\\"gl_compatibility\\"\\nrenderer/rendering_method.mobile=\\"gl_compatibility\\"\\ntextures/default_filters/use_nearest_mipmap_filter=false\\nocclusion_culling/use_occlusion_culling=true\\nenvironment/defaults/default_clear_color=Color(0.055, 0.075, 0.09, 1)\\n\\n[physics]\\ncommon/enable_pause_aware_picking=true\\n\\n[input]\\nmove_left={\\"deadzone\\":0.2,\\"events\\":[Object(InputEventKey,\\"physical_keycode\\":65),Object(InputEventKey,\\"physical_keycode\\":4194311)]}\\nmove_right={\\"deadzone\\":0.2,\\"events\\":[Object(InputEventKey,\\"physical_keycode\\":68),Object(InputEventKey,\\"physical_keycode\\":4194313)]}\\nmove_forward={\\"deadzone\\":0.2,\\"events\\":[Object(InputEventKey,\\"physical_keycode\\":87),Object(InputEventKey,\\"physical_keycode\\":4194320)]}\\nmove_back={\\"deadzone\\":0.2,\\"events\\":[Object(InputEventKey,\\"physical_keycode\\":83),Object(InputEventKey,\\"physical_keycode\\":4194322)]}\\njump={\\"deadzone\\":0.2,\\"events\\":[Object(InputEventKey,\\"physical_keycode\\":32)]}\\nrun={\\"deadzone\\":0.2,\\"events\\":[Object(InputEventKey,\\"physical_keycode\\":4194325)]}\\ninteract={\\"deadzone\\":0.2,\\"events\\":[Object(InputEventKey,\\"physical_keycode\\":69)]}\\ncluck={\\"deadzone\\":0.2,\\"events\\":[Object(InputEventKey,\\"physical_keycode\\":81)]}\\npause_game={\\"deadzone\\":0.2,\\"events\\":[Object(InputEventKey,\\"physical_keycode\\":4194305)]}\\n", "scenes/Main.tscn": "[gd_scene load_steps=2 format=3]\\n\\n[ext_resource path=\\"res://scripts/GameManager.gd\\" type=\\"Script\\" id=\\"1\\"]\\n\\n[node name=\\"TatisGame\\" type=\\"Node3D\\"]\\nscript = ExtResource(\\"1\\")\\n", "scripts/AudioManager.gd": "extends Node\\nclass_name AudioManager\\n\\nvar rng := RandomNumberGenerator.new()\\nvar music_player: AudioStreamPlayer\\nvar music_phase := 0.0\\nvar music_mode := \\"menu\\"\\n\\nfunc _ready() -> void:\\n    rng.seed = 923811\\n    music_player = AudioStreamPlayer.new()\\n    add_child(music_player)\\n\\nfunc _tone(freq: float, duration: float, volume := 0.25, wave := 0) -> AudioStreamWAV:\\n    var rate := 22050\\n    var samples := int(rate * duration)\\n    var bytes := PackedByteArray()\\n    bytes.resize(samples * 2)\\n    for i in samples:\\n        var t := float(i) / rate\\n        var env := min(1.0, t * 20.0) * max(0.0, 1.0 - t / duration)\\n        var s := sin(TAU * freq * t)\\n        if wave == 1: s = 1.0 if s >= 0.0 else -1.0\\n        elif wave == 2: s = 2.0 * (t * freq - floor(0.5 + t * freq))\\n        var v := int(clamp(s * env * volume, -1.0, 1.0) * 32767.0)\\n        bytes[i*2] = v & 255\\n        bytes[i*2+1] = (v >> 8) & 255\\n    var wav := AudioStreamWAV.new()\\n    wav.format = AudioStreamWAV.FORMAT_16_BITS\\n    wav.mix_rate = rate\\n    wav.stereo = false\\n    wav.data = bytes\\n    return wav\\n\\nfunc play_sfx(name: String) -> void:\\n    var p := AudioStreamPlayer.new(); add_child(p)\\n    match name:\\n        \\"corn\\": p.stream = _tone(880.0, 0.11, 0.22); p.pitch_scale = 1.0 + rng.randf_range(-0.08,0.08)\\n        \\"jump\\": p.stream = _tone(420.0, 0.10, 0.18, 2)\\n        \\"hurt\\": p.stream = _tone(130.0, 0.25, 0.25, 1)\\n        \\"checkpoint\\": p.stream = _tone(660.0, 0.45, 0.18)\\n        \\"lever\\": p.stream = _tone(240.0, 0.18, 0.22, 2)\\n        \\"door\\": p.stream = _tone(95.0, 0.55, 0.22, 1)\\n        \\"cluck\\": p.stream = _tone(310.0, 0.18, 0.18, 2)\\n        \\"victory\\": p.stream = _tone(1046.0, 0.8, 0.25)\\n        \\"enemy\\": p.stream = _tone(160.0, 0.3, 0.18, 1)\\n        _: p.stream = _tone(500.0, 0.12, 0.15)\\n    p.finished.connect(p.queue_free)\\n    p.play()\\n\\nfunc set_music(mode: String) -> void:\\n    music_mode = mode\\n    if music_player.playing: music_player.stop()\\n    var freq := {\\"menu\\":196.0,\\"garden\\":220.0,\\"forest\\":174.0,\\"swamp\\":146.0,\\"ruins\\":164.0,\\"heart\\":246.0,\\"victory\\":392.0}.get(mode,196.0)\\n    var wav := _tone(freq, 4.0, 0.035)\\n    wav.loop_mode = AudioStreamWAV.LOOP_FORWARD\\n    wav.loop_begin = 0\\n    wav.loop_end = int(wav.mix_rate * 4.0)\\n    music_player.stream = wav\\n    music_player.play()\\n", "scripts/CameraController.gd": "extends Node\\nclass_name CameraController\\n# La c\\u00e1mara real usa SpringArm3D dentro de PlayerController para evitar atravesar paredes.\\n", "scripts/CameraTouchArea.gd": "extends Control\\nclass_name CameraTouchArea\\nsignal dragged(delta: Vector2)\\nvar pointer_id := -1\\nfunc _ready() -> void: mouse_filter = Control.MOUSE_FILTER_STOP\\nfunc _gui_input(event: InputEvent) -> void:\\n    if event is InputEventScreenTouch:\\n        if event.pressed and pointer_id == -1: pointer_id = event.index\\n        elif not event.pressed and event.index == pointer_id: pointer_id = -1\\n    elif event is InputEventScreenDrag and event.index == pointer_id: dragged.emit(event.relative)\\n", "scripts/Checkpoint.gd": "extends Area3D\\nclass_name Checkpoint\\nsignal activated(id: int, pos: Vector3)\\nvar checkpoint_id:=0\\nvar active:=false\\nfunc setup(id: int) -> void:\\n    checkpoint_id=id; collision_layer=8; collision_mask=2\\n    var cs:=CollisionShape3D.new(); var sh:=CylinderShape3D.new(); sh.radius=1.1; sh.height=0.5; cs.shape=sh; add_child(cs)\\n    var nest:=MeshInstance3D.new(); var mesh:=TorusMesh.new(); mesh.inner_radius=0.65; mesh.outer_radius=1.0\\n    var mat:=StandardMaterial3D.new(); mat.albedo_color=Color(\\"8c5a2b\\"); mat.emission_enabled=true; mat.emission=Color(\\"4ef2b1\\"); mat.emission_energy_multiplier=0.8; mesh.material=mat; nest.mesh=mesh; add_child(nest)\\n    var light:=OmniLight3D.new(); light.light_color=Color(\\"70ffc2\\"); light.omni_range=4; light.light_energy=1.2; add_child(light)\\n    body_entered.connect(func(b): if b is PlayerController and not active: active=true; activated.emit(checkpoint_id,global_position+Vector3.UP))\\n", "scripts/CornCollectible.gd": "extends Area3D\\nclass_name CornCollectible\\nsignal collected(id: int)\\nvar corn_id := -1\\nvar base_y := 0.0\\nvar time := 0.0\\nfunc setup(id: int) -> void:\\n    corn_id=id; collision_layer=4; collision_mask=2\\n    var sh:=CollisionShape3D.new(); var ss:=SphereShape3D.new(); ss.radius=0.55; sh.shape=ss; add_child(sh)\\n    var mi:=MeshInstance3D.new(); var mesh:=CapsuleMesh.new(); mesh.radius=0.16; mesh.height=0.48\\n    var mat:=StandardMaterial3D.new(); mat.albedo_color=Color(\\"ffd93d\\"); mat.emission_enabled=true; mat.emission=Color(\\"e8a91e\\"); mat.emission_energy_multiplier=1.25; mesh.material=mat; mi.mesh=mesh; mi.rotation_degrees.x=90; add_child(mi)\\n    var particles:=GPUParticles3D.new(); particles.amount=5; particles.lifetime=1.2; particles.randomness=0.7\\n    var pm:=ParticleProcessMaterial.new(); pm.emission_shape=ParticleProcessMaterial.EMISSION_SHAPE_SPHERE; pm.emission_sphere_radius=0.28; pm.gravity=Vector3.ZERO; pm.initial_velocity_min=0.05; pm.initial_velocity_max=0.18; pm.scale_min=0.04; pm.scale_max=0.08\\n    particles.process_material=pm; var dot:=SphereMesh.new(); dot.radius=0.05; dot.height=0.1; dot.material=mat; particles.draw_pass_1=dot; add_child(particles)\\n    body_entered.connect(_on_body); base_y=position.y\\nfunc _process(delta: float) -> void:\\n    time+=delta; rotation.y+=delta*1.8; position.y=base_y+sin(time*2.2+corn_id)*0.14\\nfunc _on_body(body: Node) -> void:\\n    if body is PlayerController:\\n        set_deferred(\\"monitoring\\",false); collected.emit(corn_id); queue_free()\\n", "scripts/CornManager.gd": "extends Node\\nclass_name CornManager\\nsignal count_changed(value: int)\\nsignal all_collected\\nvar collected_ids: Array = []\\nfunc set_existing(ids: Array) -> void: collected_ids=ids.duplicate()\\nfunc collect(id: int) -> bool:\\n    if id in collected_ids:return