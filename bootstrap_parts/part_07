d,20*delta)\\n    if not is_on_floor(): velocity.y-=gravity*delta\\n    if Input.is_action_just_pressed(\\"jump\\"): request_jump()\\n    if Input.is_action_just_pressed(\\"cluck\\"): request_cluck()\\n    if Input.is_action_just_pressed(\\"interact\\"): interact_requested.emit()\\n    if dir.length()>0.1:\\n        visual.rotation.y=lerp_angle(visual.rotation.y,atan2(-dir.x,-dir.z),delta*10.0)\\n        anim_time+=delta*speed\\n        visual.position.y=-0.05+abs(sin(anim_time*2.5))*0.08\\n        for c in visual.get_children():\\n            if c.name==\\"Wing\\": c.rotation.z=sin(anim_time*3.0)*0.25\\n    else: visual.position.y=lerp(visual.position.y,-0.05,delta*6.0)\\n    move_and_slide()\\n    if global_position.y < -5: take_damage(3,Vector3.ZERO)\\n\\nfunc take_damage(amount:=1, knock:=Vector3.ZERO) -> void:\\n    if invulnerable:return\\n    hearts-=amount; hearts_changed.emit(max(0,hearts)); get_tree().call_group(\\"audio\\",\\"play_sfx\\",\\"hurt\\")\\n    velocity+=knock; invulnerable=true\\n    var tw=create_tween(); tw.tween_property(visual,\\"modulate\\",Color(1,0.35,0.35,1),0.08); tw.tween_property(visual,\\"modulate\\",Color.WHITE,0.12); tw.set_loops(5)\\n    await get_tree().create_timer(2.0).timeout\\n    invulnerable=false\\n    if hearts<=0: died.emit()\\n\\nfunc respawn() -> void:\\n    global_position=checkpoint_position; velocity=Vector3.ZERO; hearts=3; hearts_changed.emit(hearts); invulnerable=true\\n    await get_tree().create_timer(1.0).timeout; invulnerable=false\\n", "scripts/PushBox.gd": "extends RigidBody3D\\nclass_name PushBox\\nfunc build() -> void:\\n    mass=5.0; lock_rotation=true; collision_layer=64; collision_mask=1\\n    var cs:=CollisionShape3D.new(); var sh:=BoxShape3D.new(); sh.size=Vector3(1.2,1.2,1.2); cs.shape=sh; add_child(cs)\\n    var mi:=MeshInstance3D.new(); var mesh:=BoxMesh.new(); mesh.size=Vector3(1.2,1.2,1.2); var mat:=StandardMaterial3D.new(); mat.albedo_color=Color(\\"7c6b55\\"); mesh.material=mat; mi.mesh=mesh; add_child(mi)\\n", "scripts/PuzzleManager.gd": "extends Node\\nclass_name PuzzleManager\\nsignal message(text: String)\\nvar pressure_count:=0\\nvar lever_order: Array[int]=[]\\nvar crystal_count:=0\\nvar timed_open:=false\\nvar timed_door: DoorController\\nfunc register_pressure(active: bool) -> void:\\n    pressure_count=clamp(pressure_count+(1 if active else -1),0,2)\\n    if pressure_count==2: message.emit(\\"\\u00a1Las dos piedras activaron el paso secreto!\\")\\nfunc lever(id: int) -> void:\\n    lever_order.append(id)\\n    var correct=[2,0,1]\\n    if lever_order.size()>3: lever_order.clear(); lever_order.append(id)\\n    for i in lever_order.size():\\n        if lever_order[i]!=correct[i]: lever_order.clear(); message.emit(\\"Los s\\u00edmbolos se apagaron. Intenta otro orden.\\"); return\\n    if lever_order.size()==3: message.emit(\\"\\u00a1Orden correcto: luna, hoja, sol!\\")\\nfunc cluck_crystal(id: int) -> void:\\n    crystal_count=max(crystal_count,id+1); message.emit(\\"Cristal de sonido %d/3\\"%crystal_count)\\nfunc start_timed() -> void:\\n    if timed_open:return\\n    timed_open=true; if timed_door: timed_door.open(); message.emit(\\"\\u00a1Cruza antes de que termine el brillo!\\")\\n", "scripts/SaveManager.gd": "extends Node\\nclass_name SaveManager\\n\\nconst SAVE_PATH := \\"user://tatis_save.json\\"\\nconst DEFAULT_DATA := {\\n    \\"corn\\": [], \\"checkpoint\\": 0, \\"hearts\\": 3, \\"play_time\\": 0.0,\\n    \\"completed\\": false, \\"unlocks\\": [], \\"best_time\\": 0.0, \\"defeats\\": 0,\\n    \\"secrets\\": 0, \\"settings\\": {\\"music\\": 0.7, \\"sfx\\": 0.85, \\"sensitivity\\": 0.35, \\"quality\\": 1, \\"vibration\\": true}\\n}\\n\\nstatic func has_save() -> bool:\\n    return FileAccess.file_exists(SAVE_PATH)\\n\\nstatic func load_data() -> Dictionary:\\n    if not has_save(): return DEFAULT_DATA.duplicate(true)\\n    var f := FileAccess.open(SAVE_PATH, FileAccess.READ)\\n    if f == null: return DEFAULT_DATA.duplicate(true)\\n    var parsed = JSON.parse_string(f.get_as_text())\\n    if typeof(parsed) != TYPE_DICTIONARY: return DEFAULT_DATA.duplicate(true)\\n    var data := DEFAULT_DATA.duplicate(true)\\n    for key in parsed.keys(): data[key] = parsed[key]\\n    return data\\n\\nstatic func save_data(data: Dictionary) -> bool:\\n    var f := FileAccess.open(SAVE_PATH, FileAccess.WRITE)\\n    if f == null: return false\\n    f.store_string(JSON.stringify(data, \\"  \\"))\\n    return true\\n\\nstatic func reset() -> void:\\n    if has_save(): DirAccess.remove_absolute(SAVE_PATH)\\n", "scripts/SettingsManager.gd": "extends Node\\nclass_name SettingsManager\\n\\nvar values := {\\"music\\": 0.7, \\"sfx\\": 0.85, \\"sensitivity\\": 0.35, \\"quality\\": 1, \\"vibration\\": true}\\n\\nfunc apply(settings: Dictionary) -> void:\\n    for k in settings.keys(): values[k] = settings[k]\\n    AudioServer.set_bus_volume_db(0, linear_to_db(max(0.001, float(values.music))))\\n    var q := int(values.quality)\\n    if q == 0:\\n        Engine.max_fps = 30\\n    elif q == 1:\\n        Engine.max_fps = 45\\n    else:\\n        Engine.max_fps = 60\\n\\nfunc get_sensitivity() -> float:\\n    return float(values.sensitivity)\\n", "scripts/StatueEnemy.gd": "extends CharacterBody3D\\nclass_name StatueEnemy\\nvar player: PlayerController\\nvar speed:=1.4\\nfunc build() -> void:\\n    collision_layer=16; collision_mask=1\\n    var cs:=CollisionShape3D.new(); var sh:=CapsuleShape3D.new(); sh.radius=.55; sh.height=2.1; cs.shape=sh; add_child(cs)\\n    var mat:=StandardMaterial3D.new(); mat.albedo_color=Color(\\"79827d\\")\\n    var mi:=MeshInstance3D.new(); var mesh:=CylinderMesh.new(); mesh.top_radius=.42; mesh.bottom_radius=.6; mesh.height=2.2; mesh.material=mat; mi.mesh=mesh; mi.position.y=1.1; add_child(mi)\\n    var eye:=OmniLight3D.new(); eye.light_color=Color(\\"8aff7a\\"); eye.omni_range=2.0; eye.position=Vector3(0,1.7,-.4); add_child(eye)\\nfunc _physics_process(delta: float) -> void:\\n    if not is_instance_valid(player):return\\n    var to_me=(global_position-player.global_position).normalized()\\n    var forward=-player.pivot.global_basis.z\\n    var watched=forward.dot(to_me)>0.65\\n    if not watched and global_position.distance_to(player.global_position)<15:\\n        var d=player.global_position-global_position; d.y=0; velocity=d.normalized()*speed; move_and_slide()\\n    else: velocity=Vector3.ZERO\\n    if global_position.distance_to(player.global_position)<1.05: player.take_damage(3,Vector3.ZERO)\\n", "scripts/TouchControls.gd": "extends CanvasLayer\\nclass_name TouchControls\\nsignal pause_requested\\nvar player\\nvar joystick: VirtualJoystick\\n\\nfunc setup(p) -> void:\\n    player = p\\n    var root := Control.new(); root.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT); add_child(root)\\n    joystick = VirtualJoystick.new(); joystick.position = Vector2(28, 480); joystick.size = Vector2(180,180); root.add_child(joystick)\\n    joystick.changed.connect(func(v): if is_instance_valid(player): player.mobile_move = v)\\n    var cam := CameraTouchArea.new(); cam.position = Vector2(520,90); cam.size = Vector2(760,510); root.add_child(cam)\\n    cam.dragged.connect(func(d): if is_instance_valid(player): player.add_look_delta(d))\\n    _button(root,\\"SALTAR\\",Vector2(1065,510),Vector2(145,72),func(): player.request_jump(), null)\\n    _button(root,\\"CORRER\\",Vector2(895,585),Vector2(145,62),func(): player.mobile_run=true,func(): player.mobile_run=false)\\n    _button(root,\\"CACAREO\\",Vector2(895,505),Vector2(145,62),func(): player.request_cluck(),null)\\n    _button(root,\\"II\\",Vector2(1188,22),Vector2(64,54),func(): pause_requested.emit(),null)\\n\\nfunc _button(parent: Control, text: String, pos: Vector2, sz: Vector2, down: Callable, up) -> void:\\n    var b := Button.new(); b.text=text; b.position=pos; b.size=sz; b.modulate=Color(1,1,1,0.72); b.focus_mode=Control.FOCUS_NONE\\n    parent.add_child(b); b.button_down.connect(down)\\n    if up != null: